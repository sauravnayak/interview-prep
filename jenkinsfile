pipeline {
    agent any

    tools {
        maven 'Maven 3.x'
        jdk 'Java 21'
    }

    stages {
        stage('Checkout Code') {
            steps {
                cleanWs()
                checkout scm
            }
        }

        stage('Run Selenium Tests') {
            steps {
                // Triggers Maven to run your TestNG parallel suite
                sh 'mvn clean test'
            }
        }
    }

    post {
        always {
            allure includeProperties: false, jdk: '', results: [[path: 'target/allure-results']]
        }
    }

}
